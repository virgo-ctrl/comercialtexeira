# URL pública do site (canonical, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://comercialteixeira.com.br

# Webhook do n8n da Virgo (formulário e clique no WhatsApp)
N8N_WEBHOOK_URL=https://webhook.virgomarketingeia.com.br/webhook/comercial-teixeira

# API de Conversões da Meta (servidor do site). O token precisa ser de um usuário de sistema com
# permissão de gerenciamento sobre o pixel 1132095836241889. Nunca commitar.
META_CAPI_TOKEN=
# Opcional: código da aba "Testar eventos" do Gerenciador de Eventos (só para testes).
META_TEST_EVENT_CODE=
